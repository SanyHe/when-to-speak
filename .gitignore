# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Training outputs: weights and optimizer checkpoints stay out of git (they ship
# via GitHub Release / HF). The small per-run run_config.json and train_log.json
# are committed as reproducibility evidence.
output/**/final/
*.safetensors
*.bin
*.pt
*.pth
checkpoints/

# Private data (real exports, redaction) — never commit
private/

# Packaging artifacts (not committed)
standalone_train.zip
.trae-html-share-packages/
.screenshots/

# Auto Research runtime artifacts: datasets, weights, per-trial outputs
.venv/
autoresearch/models/
autoresearch/runs/
autoresearch/data/
autoresearch/logs/
autoresearch/state.json
autoresearch/loop.pid
autoresearch/loop.lock
autoresearch/STOP
autoresearch/.sealed_opened

